# "gemini" calls the real API (needs GEMINI_API_KEY); "mock" is deterministic, for tests and offline demos.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# The API has no authentication, so it listens on loopback only. Set HOST=0.0.0.0 only behind something that
# adds auth, TLS and rate limiting.
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data

# Limits. Every upload costs CPU and model calls, so these matter.
MAX_UPLOAD_MB=500
MAX_DURATION_MIN=45
MAX_CONCURRENT_JOBS=1
MAX_QUEUED_JOBS=5
JOB_TTL_HOURS=24

# Host names (no port) the server answers to besides localhost, 127.0.0.1 and [::1]. Other Host headers get 403
# (DNS rebinding protection). Comma separated, e.g. clips.example.com
ALLOWED_HOSTS=
